	bash scripts/test_gate_claim_computes_the_premise.sh   # ~7.8s MEASURED (7.85/7.9 on 2026-09-20, 10 arms + 5 fail-once mutants), hermetic (its own scratch postoffice under mktemp; it scrubs S4E_PID_LOCK, the dispatch opt-out AND both premise variables out of its environment, because it is itself a DONE-WHEN and runs INSIDE a `done` that would otherwise disable the feature under test). ⭐ WIRED 2026-09-20 (coo, ceo CEO-1002): `claim` and `next` RUN the baton's PREMISE-WHEN and refuse the lock on a measured red, the symmetric half of `done` running its DONE-WHEN. ⛔ IT BELONGS IN THIS TARGET AND NOT IN `test`: every seat's claim/next rides on this one tool, so a red here is a red for all eight seats at once, and it is hermetic by the membership rule three lines above -- own scratch postoffice, no build, seconds. ⛔ THE ARM THAT MATTERS IS 6, NOT 1: an ASSIGNED row never passes through `claim`, so a cure wired only into `claim` leaves the fleet's COMMONEST dispatch unchecked, and mutant M2 unwires exactly that half to prove the arm can see it.
	@echo "  ✅ test-postoffice: hermetic s4e_* gates green (count them in this recipe, never from a remembered number)"

SHELL := /bin/bash
preflight:  # ⭐ THE CHEAP HERMETIC ARMS, WITH NO BUILD (hq_T's ask 2026-09-06, measured by them: the Makefile had all/pristine/test/test-postoffice/buildinfo/scrip/clean and NO cheap target of any kind, so EVERY sub-second hermetic arm was trapped behind a full build -- a STRUCTURAL disincentive, not anyone's discipline). ⛔ THE MISSING `scrip` PREREQUISITE IS THE ENTIRE POINT OF THIS TARGET AND MUST NOT BE ADDED. Population DECLARED in scripts/preflight_arms.txt because a static grep cannot classify it in either direction (it convicts strip_comments.py, which says "make test" in its prose, and it clears test_gate_pl_quad_regs.sh, which reaches the compiler through a lib_ helper without naming it); scripts/test_gate_preflight_arms_stay_cheap.sh PINS EVERY ARM BY MEASURED DURATION so this cannot quietly acquire a 45-second arm and stop being worth running.
	@bad=0; n=0; \
	while read -r arm; do \
	  n=$$((n + 1)); \
	  case "$$arm" in *.py*) out=$$(cd "$(ROOT)" && python3 $$arm </dev/null 2>&1) ;; *) out=$$(cd "$(ROOT)" && bash $$arm </dev/null 2>&1) ;; esac; \
	  rc=$$?; \
	  if [ $$rc -ne 0 ]; then bad=$$((bad + 1)); printf '  RED  rc=%-3s %s\n' "$$rc" "$${arm%% *}"; printf '%s\n' "$$out" | tail -3 | sed 's/^/       /'; fi; \
	done < <(grep -E '^scripts/' "$(ROOT)/scripts/preflight_arms.txt"); \
	echo "preflight: $$n arm(s), $$bad red -- NO BUILD, hermetic. NOT a substitute for the test target: it cannot see a codegen defect."; \
	[ $$bad -eq 0 ]

arena: export SCRIP_HEAP_KB := $(SCRIP_HEAP_KB_TINY)
arena:  # ⭐ WHAT ARENA WILL THE TINY PASS USE? print it rather than assume it (LAW 0), and it is the one place test-arena's arena is decided.
	@printf 'ARENA SCRIP_HEAP_KB=%s  (the committed window for the tiny-arena pass; raise it with SCRIP_HEAP_KB_TINY=N. The reserve is the larger of 8x this and the shipped default, so a tiny window refuses no live set)\n' "$$SCRIP_HEAP_KB"

test-arena: export SCRIP_HEAP_KB := $(SCRIP_HEAP_KB_TINY)
test-arena: scrip arena  # ⛔⭐ LON'S TINY-ARENA PASS, MANDATORY PER COLLECTOR LANDING (Lon 2026-09-19; ceo CEO-938/939; RULES.md batch 28 CLAUSE 2; gate test_gate_gc_the_tiny_arena_is_the_default_of_gc_testing.sh). Every arm below runs with a 1 MB committed window, which collects wherever the program allocates a megabyte -- the exasperation Lon asked for, and on its first afternoon it found nine SNOBOL4 programs and two Icon programs that the shipped arena passes. ⛔ THIS IS A SECOND PASS, NOT `make test`'s ENVIRONMENT: a landing gate grades the configuration we ship (CEO-939 measured the alternative -- the blanket export took the 360-arm set to 32 red, including gates that grade shipped behaviour correctly at 512), and every red HERE is a row, never a blocked fleet. ⛔ AND IT IS RED BY DESIGN TODAY: two arms below are the collector findings of 2026-09-19 (gc2's Arizona witness and the co-expression frame image, both green at 512 and red at 1 MB), each on a row of its own; a seat reads the NAMES, not the exit code, until those rows close.
	@bad=0; ref=0; n=0; \
	for g in scripts/test_gate_gc_*.sh; do \
	  n=$$((n + 1)); \
	  if out=$$(bash "$$g" 2>&1); then printf '  GREEN  %s\n' "$$(basename $$g)"; \
	  else rc=$$?; if [ $$rc -eq 2 ]; then ref=$$((ref + 1)); else bad=$$((bad + 1)); fi; printf '  %-7s %s  rc=%s\n' "$$([ $$rc -eq 2 ] && echo REFUSED || echo RED)" "$$(basename $$g)" "$$rc"; printf '%s\n' "$$out" | tail -4 | sed 's/^/           /'; fi; \
	done; \
	for l in snobol4 icon prolog pascal raku rebus snocone; do \
	  n=$$((n + 1)); \
	  if bash scripts/test_smoke_$$l.sh >/dev/null 2>&1; then printf '  GREEN  smoke %s\n' "$$l"; else bad=$$((bad + 1)); printf '  RED    smoke %s\n' "$$l"; fi; \
	done; \
	printf 'test-arena: arms=%s red=%s refused=%s at SCRIP_HEAP_KB=%s -- every RED here is a collector finding and owes a ROW; a REFUSED arm COULD NOT MEASURE (a ceiling that fired, a missing prerequisite) and owes its REASON, never a collector row (coo 2026-09-20 on the cfo CFO-121/122: the mark-walk arm needs 651s at 1 MB against a 300s ceiling, and rc=124 was being tallied and read as a lost root). Both still fail this target -- unmeasured must not read green -- but a reader can now tell a clock from a collector (the arena is named on the line above; a suite board run under this pass names it too)\n' "$$n" "$$bad" "$$ref" "$$SCRIP_HEAP_KB"; \
	[ $$bad -eq 0 ] && [ $$ref -eq 0 ]

