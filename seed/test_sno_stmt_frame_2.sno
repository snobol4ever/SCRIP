        DEFINE('FACT(N)')             :(MAIN1)
FACT    LE(N,1)                       :F(RECURSE)
        FACT = 1                      :(RETURN)
RECURSE FACT = N * FACT(N - 1)        :(RETURN)
MAIN1   DEFINE('NOPE()')              :(MAIN)
NOPE                                  :(FRETURN)
MAIN    OUTPUT = FACT(5)
        OUTPUT = NOPE()
        OUTPUT = 7
END
