# WITNESS for the CREATE RECORD's INHERITED SUBJECT: a co-expression created inside a string scan inherits
# &subject/&pos through the register contract (r13/r14/r15 marshalled into the entry package); collections
# between the create and the first activation slide the subject block, and the package's r13 word must be
# relocated by a typed visit (the package is tagged sigma_live at creation because scan_depth > 0). The body
# then reads the first word of the subject through that inherited register. Correct output: alpha, then done.
global G, L
procedure junk_maker()
   return list(2000, 7)
end
procedure main()
   local line, letters, junk, i, s, e
   every i := 1 to 2 do { L := junk_maker(); if i = 1 then G := L };
   every i := 1 to 400 do junk := repl("w", 60);
   letters := &lcase ++ &ucase;
   line := repl("alpha beta gamma ", 4) || "omega";
   line ? { tab(upto(letters)); e := create tab(many(letters)); G := &null; every i := 1 to 60 do junk := list(3, i); s := @e; write(s) };
   write("done");
end
