# A record field store inside a scan polls through x86_rt_gc_poll_rec_res while r13 holds the scan subject base; the poll hands the saved
# r13 to rt_gc_point_arr_probe_c, so a collection there rewrites it. Unshielded, the next move() reads the vacated ground (error 102 on poison).
record r(c)
procedure f(line)
   local x, o;
   o := r();
   line ? {
      o.c := move(4);
      x := 0;
      while x +:= move(4) - 5000 do
         0
   };
   return x;
end
procedure main()
   local i, n;
   n := 0;
   every i := 1 to 200 do n +:= f("ABCD5001" || right(i, 4, "0") || "50035004");
   write(n);
end
