# BOX ARBNO() .section .data .Lrtc4_z: .quad 0 .section .text .intel_syntax noprefix (null): push r10 sub rsp, 8 lea rdi, [rip + .Lrtc4_z] mov esi, 0 call rt_bb_arbno@PLT add rsp, 8 pop r10 cmp al, 99 jne L_succ_audit jmp L_fail_audit L_back_audit: push r10 sub rsp, 8 lea rdi, [rip + .Lrtc4_z] mov esi, 1 call rt_bb_arbno@PLT add rsp, 8 pop r10 cmp al, 99 jne L_succ_audit jmp L_fail_audit
