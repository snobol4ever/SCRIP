function make_pat_S_N(ms) { const n = 10; let delta = 0; let self = { succ: null, fail: null, α() { if (ms.delta > n || ms.delta > ms.omega) { self.fail.α(); return; } delta = n - ms.delta; if (ms.delta + delta > ms.omega) delta = ms.omega - ms.delta; const r = ms.sigma.slice(ms.delta, ms.delta + delta); ms.delta += delta; self.succ.α(); return r; }, β() { ms.delta -= delta; self.fail.α(); } }; return self; }
