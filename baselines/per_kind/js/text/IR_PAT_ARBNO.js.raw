function make_pat_S_N(ms) { const stack = []; let self = { succ: null, fail: null, α() { stack.length = 0; stack.push({ start: ms.delta }); while (true) { const frame = stack[stack.length - 1]; const br = self.body.α(); if (br === null) { return ms.sigma.slice(stack[0].start, ms.delta - stack[0].start); } if (ms.delta === frame.start) { return ms.sigma.slice(stack[0].start, ms.delta - stack[0].start); } stack.push({ start: ms.delta }); } }, β() { if (stack.length <= 1) { self.fail.α(); return; } stack.pop(); const frame = stack[stack.length - 1]; ms.delta = frame.start; return ms.sigma.slice(stack[0].start, ms.delta - stack[0].start); } }; return self; }
