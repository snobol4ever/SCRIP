function make_pat_S_N(ms) { const chars = "."; let delta = 0; let self = { succ: null, fail: null, α() { delta = 0; while (ms.delta + delta < ms.omega && chars.indexOf(ms.sigma[ms.delta + delta]) < 0) delta++; const r = ms.sigma.slice(ms.delta, ms.delta + delta); ms.delta += delta; self.succ.α(); return r; }, β() { ms.delta -= delta; self.fail.α(); } }; return self; }
