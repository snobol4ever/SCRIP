function make_pat_S_N(ms) { let self = { succ: null, fail: null, α() { const lr = self.left.α(); if (lr === null) { self.fail.α(); return; } let rr = self.right.α(); while (rr === null) { const lr2 = self.left.β(); if (lr2 === null) { self.fail.α(); return; } rr = self.right.α(); } self.succ.α(); return rr; }, β() { let rr = self.right.β(); while (rr === null) { const lr = self.left.β(); if (lr === null) { self.fail.α(); return; } rr = self.right.α(); } return rr; } }; return self; }
