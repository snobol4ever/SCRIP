    "  if (i <= length(s)) and ((s[i] = '-') or (s[i] = '+')) then begin neg := s[i] = '-'; i := i + 1 end;\n"
    "  if (i <= length(s)) and (s[i] = '$') then\n"
    "  begin\n"
