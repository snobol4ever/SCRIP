    "function __strhlp_tolower(const __sh_s: string): string;\n"
    "begin\n"
    "  __strhlp_tolower := LowerCase(__sh_s);\n"
    "end;\n"
    "function __strhlp_trim(const __sh_s: string): string;\n"
    "begin\n"
    "  __strhlp_trim := Trim(__sh_s);\n"
