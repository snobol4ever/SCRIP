    "function IntToStr(n: integer): string;\n"
    "var r: string; neg: boolean;\n"
    "begin\n"
    "  setlength(r, 0);\n"
    "  neg := n < 0;\n"
    "  if neg then n := -n;\n"
    "  repeat\n"
    "    r := chr(ord('0') + n mod 10) + r;\n"
    "    n := n div 10\n"
    "  until n = 0;\n"
    "  if neg then r := '-' + r;\n"
    "  IntToStr := r\n"
