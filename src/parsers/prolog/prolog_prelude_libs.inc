    "'$clpfd_a'(A, B, C, D) :-\n"
    "    (   var(A),\n"
    "        E=C\n"
    "    ->  E=[a(A, B)|D]\n"
    "    ;   '$clpfd_a'(B, C, D)\n"
    "    ).\n"
