    "'$clpfd_match_variables'([A|B], [C|D], E, F) :-\n"
    "    '$clpfd_state'(s(G, H, I, J), E, K),\n"
    "    (   '$clpfd_template_var_path'(H, A, L)\n"
    "    ->  '$clpfd_path_term_variable'(L, G, C)\n"
    "    ;   '$clpfd_template_var_path'(I, A, L)\n"
    "    ->  '$clpfd_path_term_variable'(L, J, C)\n"
    "    ;   domain_error(variable_from_template_or_counters, A)\n"
    "    ),\n"
    "    M=K,\n"
    "    '$clpfd_match_variables'(B, D, M, F).\n"
    "'$clpfd_nodes_nums'([], [], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_nodes_nums'([A|B], [C|D], E, F) :-\n"
    "    '$clpfd_node_num'(A, C, E, G),\n"
    "    '$clpfd_nodes_nums'(B, D, G, F).\n"
    "'$clpfd_arcs_relation'([], [], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_arcs_relation'([arc(A, B, C, D)|E], [[F, B, G|H]|I], J, K) :-\n"
    "    '$clpfd_node_num'(A, F, J, L),\n"
    "    '$clpfd_node_num'(C, G, L, M),\n"
    "    '$clpfd_state'(s(N, O),\n"
    "          s(N, P),\n"
    "          M,\n"
    "          Q),\n"
    "    '$clpfd_exprs_nums'(D, H, O, P),\n"
    "    R=Q,\n"
    "    '$clpfd_arcs_relation'(E, I, R, K).\n"
    "'$clpfd_exprs_nums'([], [], [], []).\n"
    "'$clpfd_exprs_nums'([A|B], [C|D], [E-F|G], [H-I|J]) :-\n"
    "    (   member(K-C, E),\n"
    "        K==A\n"
    "    ->  I=F,\n"
    "        H=E\n"
    "    ;   C=F,\n"
    "        I is F+1,\n"
    "        H=[A-F|E]\n"
    "    ),\n"
    "    '$clpfd_exprs_nums'(B, D, G, J).\n"
    "'$clpfd_node_num'(A, B, C, D) :-\n"
    "    '$clpfd_state'(s(E-F, G),\n"
    "          s(H-I, G),\n"
    "          C,\n"
    "          J),\n"
    "    (   member(K-B, E),\n"
    "        K==A\n"
    "    ->  I=F,\n"
    "        H=E\n"
    "    ;   B=F,\n"
    "        I is F+1,\n"
    "        H=[A-F|E]\n"
    "    ),\n"
    "    D=J.\n"
    "'$clpfd_include_args1'(A, B, C) :-\n"
    "    include(A, B, D),\n"
    "    maplist(arg(1), D, C).\n"
    "'$clpfd_source'(source(_)).\n"
    "'$clpfd_sink'(sink(_)).\n"
    "'$clpfd_monotonic'(A, ?(A)).\n"
    "'$clpfd_arc_normalized'(A, B, C) :-\n"
    "    '$clpfd_arc_normalized_'(B, A, C).\n"
    "'$clpfd_arc_normalized_'(arc(A, B, C, D), _, arc(A, B, C, D)).\n"
    "'$clpfd_arc_normalized_'(arc(A, B, C), D, arc(A, B, C, D)).\n"
    "transpose(A, B) :-\n"
    "    must_be(list(list), A),\n"
    "    '$clpfd_lists_transpose'(A, B).\n"
    "'$clpfd_lists_transpose'([], []).\n"
    "'$clpfd_lists_transpose'([A|B], C) :-\n"
    "    maplist(same_length(A), B),\n"
    "    foldl('$clpfd_transpose_', A, C, [A|B], _).\n"
    "'$clpfd_transpose_'(_, A, B, C) :-\n"
    "    maplist('$clpfd_list_first_rest', B, A, C).\n"
    "'$clpfd_list_first_rest'([A|B], A, B).\n"
    "zcompare(A, B, C) :-\n"
    "    (   nonvar(A)\n"
    "    ->  '$clpfd_zcompare_'(A, B, C)\n"
    "    ;   integer(B),\n"
    "        integer(C)\n"
    "    ->  compare(A, B, C)\n"
    "    ;   freeze(A, '$clpfd_zcompare_'(A, B, C)),\n"
    "        '$clpfd_fd_variable'(B),\n"
    "        '$clpfd_fd_variable'(C),\n"
    "        '$clpfd_propagator_init_trigger'([B, C],\n"
    "                                pzcompare(A, B, C))\n"
    "    ).\n"
    "'$clpfd_zcompare_'(=, A, B) :-\n"
    "    (   integer(A)\n"
    "    ->  (   var(B)\n"
    "        ->  B=A\n"
    "        ;   integer(B)\n"
    "        ->  A=:=B\n"
    "        ;   C=A,\n"
    "            clpfd:'$clpfd_clpfd_equal'(C, ?(B))\n"
    "        )\n"
    "    ;   integer(B)\n"
    "    ->  (   var(A)\n"
    "        ->  A=B\n"
    "        ;   C=B,\n"
    "            clpfd:'$clpfd_clpfd_equal'(?(A), C)\n"
    "        )\n"
    "    ;   clpfd:'$clpfd_clpfd_equal'(?(A), ?(B))\n"
    "    ).\n"
    "'$clpfd_zcompare_'(<, A, B) :-\n"
    "    (   integer(B)\n"
    "    ->  (   integer(A)\n"
    "        ->  B>=A+1\n"
    "        ;   C=B,\n"
    "            clpfd:'$clpfd_clpfd_geq'(C, ?(A)+1)\n"
    "        )\n"
    "    ;   integer(A)\n"
    "    ->  C is A+1,\n"
    "        clpfd:'$clpfd_clpfd_geq'(?(B), C)\n"
    "    ;   clpfd:'$clpfd_clpfd_geq'(?(B), ?(A)+1)\n"
    "    ).\n"
    "'$clpfd_zcompare_'(>, A, B) :-\n"
    "    (   integer(A)\n"
    "    ->  (   integer(B)\n"
    "        ->  A>=B+1\n"
    "        ;   C=A,\n"
    "            clpfd:'$clpfd_clpfd_geq'(C, ?(B)+1)\n"
    "        )\n"
    "    ;   integer(B)\n"
    "    ->  C is B+1,\n"
    "        clpfd:'$clpfd_clpfd_geq'(?(A), C)\n"
    "    ;   clpfd:'$clpfd_clpfd_geq'(?(A), ?(B)+1)\n"
    "    ).\n"
    "chain(A, B) :-\n"
    "    must_be(list, A),\n"
    "    maplist('$clpfd_fd_variable', A),\n"
    "    must_be(ground, B),\n"
    "    (   '$clpfd_chain_relation'(B)\n"
    "    ->  true\n"
    "    ;   domain_error(chain_relation, B)\n"
    "    ),\n"
    "    '$clpfd_chain_'(A, B).\n"
    "'$clpfd_chain_'([], _).\n"
    "'$clpfd_chain_'([A|B], C) :-\n"
    "    foldl('$clpfd_chain'(C), B, A, _).\n"
    "'$clpfd_chain_relation'(#=).\n"
    "'$clpfd_chain_relation'(#<).\n"
    "'$clpfd_chain_relation'(#=<).\n"
    "'$clpfd_chain_relation'(#>).\n"
    "'$clpfd_chain_relation'(#>=).\n"
    "'$clpfd_chain'(A, B, C, B) :-\n"
    "    call(A, ?(C), ?(B)).\n"
    "fd_var(A) :-\n"
    "    get_attr(A, clpfd, _).\n"
    "fd_inf(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_infimum'(C, D),\n"
    "        '$clpfd_bound_portray'(D, B)\n"
    "    ;   must_be(integer, A),\n"
    "        B=A\n"
    "    ).\n"
    "fd_sup(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_supremum'(C, D),\n"
    "        '$clpfd_bound_portray'(D, B)\n"
    "    ;   must_be(integer, A),\n"
    "        B=A\n"
    "    ).\n"
    "fd_size(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_num_elements'(C, D),\n"
    "        '$clpfd_bound_portray'(D, B)\n"
    "    ;   must_be(integer, A),\n"
    "        B=1\n"
    "    ).\n"
    "fd_dom(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_to_drep'(C, B)\n"
    "    ;   must_be(integer, A),\n"
    "        B=A..A\n"
    "    ).\n"
    "fd_degree(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, _, C)\n"
    "    ->  '$clpfd_props_number'(C, B)\n"
    "    ;   must_be(integer, A),\n"
    "        B=0\n"
    "    ).\n"
    "A in_set B :-\n"
    "    '$clpfd_domain'(A, B).\n"
    "fd_set(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, B, _)\n"
    "    ->  true\n"
    "    ;   must_be(integer, A),\n"
    "        B=from_to(n(A), n(A))\n"
    "    ).\n"
    "is_fdset(A) :-\n"
    "    nonvar(A),\n"
    "    '$clpfd_is_domain'(A).\n"
    "empty_fdset(empty).\n"
    "fdset_parts(from_to(A, B), C, D, empty) :-\n"
    "    !,\n"
    "    fdset_interval(from_to(A, B), C, D).\n"
    "fdset_parts(A, B, C, D) :-\n"
    "    var(A),\n"
    "    !,\n"
    "    A=split(E, F, D),\n"
    "    fdset_interval(F, B, C),\n"
    "    C\\==sup,\n"
    "    E is C+1,\n"
    "    '$clpfd_all_greater_than'(D, E).\n"
    "fdset_parts(split(_, empty, A), B, C, D) :-\n"
    "    !,\n"
    "    fdset_parts(A, B, C, D).\n"
    "fdset_parts(split(A, B, C), D, E, F) :-\n"
    "    fdset_parts(B, D, E, G),\n"
    "    (   G==empty\n"
    "    ->  F=C\n"
    "    ;   F=split(A, G, C)\n"
    "    ).\n"
    "empty_interval(inf, inf) :-\n"
    "    !.\n"
    "empty_interval(sup, inf) :-\n"
    "    !.\n"
    "empty_interval(sup, sup) :-\n"
    "    !.\n"
    "empty_interval(A, B) :-\n"
    "    A\\==inf,\n"
    "    B\\==sup,\n"
    "    A>B.\n"
    "fdset_interval(from_to(inf, sup), inf, sup) :-\n"
    "    !.\n"
    "fdset_interval(from_to(inf, n(A)), inf, A) :-\n"
    "    !,\n"
    "    integer(A).\n"
    "fdset_interval(from_to(n(A), sup), A, sup) :-\n"
    "    !,\n"
    "    integer(A).\n"
    "fdset_interval(from_to(n(A), n(B)), A, B) :-\n"
    "    integer(A),\n"
    "    integer(B),\n"
    "    A=<B.\n"
    "fdset_singleton(A, B) :-\n"
    "    fdset_interval(A, B, B).\n"
    "fdset_min(A, B) :-\n"
    "    '$clpfd_domain_infimum'(A, C),\n"
    "    '$clpfd_bound_portray'(C, B).\n"
    "fdset_max(A, B) :-\n"
    "    '$clpfd_domain_supremum'(A, C),\n"
    "    '$clpfd_bound_portray'(C, B).\n"
    "fdset_size(A, B) :-\n"
    "    '$clpfd_domain_num_elements'(A, C),\n"
    "    '$clpfd_bound_portray'(C, B).\n"
    "list_to_fdset(A, B) :-\n"
    "    '$clpfd_list_to_domain'(A, B).\n"
    "fdset_to_list(A, B) :-\n"
    "    '$clpfd_domain_to_list'(A, B).\n"
    "range_to_fdset(A, B) :-\n"
    "    '$clpfd_drep_to_domain'(A, B).\n"
    "fdset_to_range(empty, 1..0) :-\n"
    "    !.\n"
    "fdset_to_range(A, B) :-\n"
    "    '$clpfd_domain_to_drep'(A, B).\n"
    "fdset_add_element(A, B, C) :-\n"
    "    fdset_singleton(D, B),\n"
    "    '$clpfd_domains_union'(A, D, C).\n"
    "fdset_del_element(A, B, C) :-\n"
    "    '$clpfd_domain_remove'(A, B, C).\n"
    "fdset_disjoint(A, B) :-\n"
    "    \\+ fdset_intersect(A, B).\n"
    "fdset_intersect(A, B) :-\n"
    "    '$clpfd_domains_intersection'(A, B, _).\n"
    "fdset_intersection(A, B, C) :-\n"
    "    '$clpfd_domains_intersection_'(A, B, C).\n"
    "fdset_member(A, B) :-\n"
    "    (   var(A)\n"
    "    ->  '$clpfd_domain_direction_element'(B, up, A)\n"
    "    ;   integer(A),\n"
    "        '$clpfd_domain_contains'(B, A)\n"
    "    ).\n"
    "fdset_eq(empty, empty) :-\n"
    "    !.\n"
    "fdset_eq(A, B) :-\n"
    "    fdset_parts(A, C, D, E),\n"
    "    fdset_parts(B, C, D, F),\n"
    "    fdset_eq(E, F).\n"
    "fdset_subset(A, B) :-\n"
    "    '$clpfd_domain_subdomain'(B, A).\n"
    "fdset_subtract(A, B, C) :-\n"
    "    '$clpfd_domain_subtract'(A, B, C).\n"
    "fdset_union(A, B, C) :-\n"
    "    '$clpfd_domains_union'(A, B, C).\n"
    "fdset_union([], empty).\n"
    "fdset_union([A|B], C) :-\n"
    "    '$clpfd_fdset_union_'(B, A, C).\n"
    "'$clpfd_fdset_union_'([], A, A).\n"
    "'$clpfd_fdset_union_'([A|B], C, D) :-\n"
    "    '$clpfd_domains_union'(C, A, E),\n"
    "    '$clpfd_fdset_union_'(B, E, D).\n"
    "fdset_complement(A, B) :-\n"
    "    '$clpfd_domain_complement'(A, B).\n"
    "'$clpfd_goals_entail'(A, B) :-\n"
    "    must_be(list, A),\n"
    "    \\+ ( maplist(call, A),\n"
    "         #\\B,\n"
    "         term_variables(A-B, C),\n"
    "         label(C)\n"
    "       ).\n"
    "clpfd:attr_unify_hook(clpfd_attr(_, _, _, A, B), C) :-\n"
    "    (   nonvar(C)\n"
    "    ->  (   integer(C)\n"
    "        ->  true\n"
    "        ;   type_error(integer, C)\n"
    "        ),\n"
    "        '$clpfd_domain_contains'(A, C),\n"
    "        '$clpfd_trigger_props'(B),\n"
    "        '$clpfd_do_queue'\n"
    "    ;   '$clpfd_fd_get'(C, D, E),\n"
    "        '$clpfd_domains_intersection'(D, A, F),\n"
    "        '$clpfd_append_propagators'(B, E, G),\n"
    "        '$clpfd_fd_put'(C, F, G),\n"
    "        '$clpfd_trigger_props'(G),\n"
    "        '$clpfd_do_queue'\n"
    "    ).\n"
    "'$clpfd_append_propagators'(fd_props(A, B, C), fd_props(D, E, F), fd_props(G, H, I)) :-\n"
    "    maplist(append,\n"
    "            [A, B, C],\n"
    "            [D, E, F],\n"
    "            [G, H, I]).\n"
    "'$clpfd_bound_portray'(inf, inf).\n"
    "'$clpfd_bound_portray'(sup, sup).\n"
    "'$clpfd_bound_portray'(n(A), A).\n"
    "'$clpfd_list_to_drep'(A, B) :-\n"
    "    '$clpfd_list_to_domain'(A, C),\n"
    "    '$clpfd_domain_to_drep'(C, B).\n"
    "'$clpfd_domain_to_drep'(A, B) :-\n"
    "    '$clpfd_domain_intervals'(A, [C-D|E]),\n"
    "    '$clpfd_bound_portray'(C, F),\n"
    "    '$clpfd_bound_portray'(D, G),\n"
    "    (   F==G\n"
    "    ->  H=F\n"
    "    ;   H=F..G\n"
    "    ),\n"
    "    '$clpfd_intervals_to_drep'(E, H, B).\n"
    "'$clpfd_intervals_to_drep'([], A, A).\n"
    "'$clpfd_intervals_to_drep'([A-B|C], D, E) :-\n"
    "    '$clpfd_bound_portray'(A, F),\n"
    "    '$clpfd_bound_portray'(B, G),\n"
    "    (   F==G\n"
    "    ->  H=F\n"
    "    ;   H=F..G\n"
    "    ),\n"
    "    '$clpfd_intervals_to_drep'(C, D\\/H, E).\n"
    "clpfd:attribute_goals(A, B, C) :-\n"
    "    ( get_attr(A,\n"
    "               clpfd,\n"
    "               clpfd_attr(_,\n"
    "                          _,\n"
    "                          _,\n"
    "                          D,\n"
    "                          fd_props(E, F, G))),\n"
    "      append(E, F, H),\n"
    "      append(H, G, I),\n"
    "      '$clpfd_domain_to_drep'(D, J)\n"
    "    ),\n"
    "    K=B,\n"
    "    (   '$clpfd_default_domain'(D),\n"
    "        \\+ '$clpfd_all_dead_'(I),\n"
    "        L=K\n"
    "    ->  L=M\n"
    "    ;   K=[clpfd:(A in J)|M]\n"
    "    ),\n"
    "    '$clpfd_attributes_goals'(I, M, C).\n"
    "clpfd_aux:attribute_goals(_, A, B) :-\n"
    "    A=B.\n"
    "clpfd_aux:attr_unify_hook(_, _) :-\n"
    "    false.\n"
    "clpfd_gcc_vs:attribute_goals(_, A, B) :-\n"
    "    A=B.\n"
    "clpfd_gcc_vs:attr_unify_hook(_, _) :-\n"
    "    false.\n"
    "clpfd_gcc_num:attribute_goals(_, A, B) :-\n"
    "    A=B.\n"
    "clpfd_gcc_num:attr_unify_hook(_, _) :-\n"
    "    false.\n"
    "clpfd_gcc_occurred:attribute_goals(_, A, B) :-\n"
    "    A=B.\n"
    "clpfd_gcc_occurred:attr_unify_hook(_, _) :-\n"
    "    false.\n"
    "clpfd_relation:attribute_goals(_, A, B) :-\n"
    "    A=B.\n"
    "clpfd_relation:attr_unify_hook(_, _) :-\n"
    "    false.\n"
    "'$clpfd_attributes_goals'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attributes_goals'([propagator(A, B)|C], D, E) :-\n"
    "    (   ground(B),\n"
    "        F=D\n"
    "    ->  F=G\n"
    "    ;   '$clpfd_attribute_goal_'(A, H, []),\n"
    "        I=D\n"
    "    ->  ( del_attr(B, clpfd_aux),\n"
    "          B=processed,\n"
    "          (   current_prolog_flag(clpfd_monotonic, true)\n"
    "          ->  maplist('$clpfd_unwrap_with'('$clpfd_bare_integer'), H, J)\n"
    "          ;   maplist('$clpfd_unwrap_with'(=), H, J)\n"
    "          ),\n"
    "          maplist('$clpfd_with_clpfd', J, K)\n"
    "        ),\n"
    "        L=I,\n"
    "        '$clpfd_list'(K, L, G)\n"
    "    ;   D=[A|G]\n"
    "    ),\n"
    "    '$clpfd_attributes_goals'(C, G, E).\n"
    "'$clpfd_with_clpfd'(A, clpfd:A).\n"
    "'$clpfd_unwrap_with'(_, A, A) :-\n"
    "    var(A),\n"
    "    !.\n"
    "'$clpfd_unwrap_with'(A, ?(B), C) :-\n"
    "    !,\n"
    "    call(A, B, C).\n"
    "'$clpfd_unwrap_with'(A, B, C) :-\n"
    "    B=..[D|E],\n"
    "    maplist('$clpfd_unwrap_with'(A), E, F),\n"
    "    C=..[D|F].\n"
    "'$clpfd_bare_integer'(A, B) :-\n"
    "    (   integer(A)\n"
    "    ->  B=A\n"
    "    ;   B= #(A)\n"
    "    ).\n"
    "'$clpfd_attribute_goal_'(presidual(A), B, C) :-\n"
    "    B=[A|C].\n"
    "'$clpfd_attribute_goal_'(pgeq(A, B), C, D) :-\n"
    "    C=[?(A)#>= ?(B)|D].\n"
    "'$clpfd_attribute_goal_'(pplus(A, B, C), D, E) :-\n"
    "    D=[?(A)+ ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pneq(A, B), C, D) :-\n"
    "    C=[?(A)#\\= ?(B)|D].\n"
    "'$clpfd_attribute_goal_'(ptimes(A, B, C), D, E) :-\n"
    "    D=[?(A)* ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(absdiff_neq(A, B, C), D, E) :-\n"
    "    D=[abs(?(A)- ?(B))#\\=C|E].\n"
    "'$clpfd_attribute_goal_'(absdiff_geq(A, B, C), D, E) :-\n"
    "    D=[abs(?(A)- ?(B))#>=C|E].\n"
    "'$clpfd_attribute_goal_'(x_neq_y_plus_z(A, B, C), D, E) :-\n"
    "    D=[?(A)#\\= ?(B)+ ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(x_leq_y_plus_c(A, B, C), D, E) :-\n"
    "    D=[?(A)#=< ?(B)+C|E].\n"
    "'$clpfd_attribute_goal_'(ptzdiv(A, B, C), D, E) :-\n"
    "    D=[?(A)// ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pdiv(A, B, C), D, E) :-\n"
    "    D=[?(A)div?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(prdiv(A, B, C), D, E) :-\n"
    "    D=[?(A)rdiv?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pshift(A, B, C, 1), D, E) :-\n"
    "    D=[?(A)<< ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pshift(A, B, C, -1), D, E) :-\n"
    "    D=[?(A)>> ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pexp(A, B, C), D, E) :-\n"
    "    D=[?(A)^ ?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pabs(A, B), C, D) :-\n"
    "    C=[?(B)#=abs(?(A))|D].\n"
    "'$clpfd_attribute_goal_'(pmod(A, B, C), D, E) :-\n"
    "    D=[?(A)mod?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(prem(A, B, C), D, E) :-\n"
    "    D=[?(A)rem?(B)#= ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(pmax(A, B, C), D, E) :-\n"
    "    D=[?(C)#=max(?(A), ?(B))|E].\n"
    "'$clpfd_attribute_goal_'(pmin(A, B, C), D, E) :-\n"
    "    D=[?(C)#=min(?(A), ?(B))|E].\n"
    "'$clpfd_attribute_goal_'(scalar_product_neq(A, B, C), D, E) :-\n"
    "    D=[F#\\=G|H],\n"
    "    '$clpfd_scalar_product_left_right'([-1|A],\n"
    "                              [C|B],\n"
    "                              F,\n"
    "                              G),\n"
    "    E=H.\n"
    "'$clpfd_attribute_goal_'(scalar_product_eq(A, B, C), D, E) :-\n"
    "    D=[F#=G|H],\n"
    "    '$clpfd_scalar_product_left_right'([-1|A],\n"
    "                              [C|B],\n"
    "                              F,\n"
    "                              G),\n"
    "    E=H.\n"
    "'$clpfd_attribute_goal_'(scalar_product_leq(A, B, C), D, E) :-\n"
    "    D=[F#=<G|H],\n"
    "    '$clpfd_scalar_product_left_right'([-1|A],\n"
    "                              [C|B],\n"
    "                              F,\n"
    "                              G),\n"
    "    E=H.\n"
    "'$clpfd_attribute_goal_'(pdifferent(_, _, _, A), B, C) :-\n"
    "    '$clpfd_original_goal'(A, B, C).\n"
    "'$clpfd_attribute_goal_'(weak_distinct(_, _, _, A), B, C) :-\n"
    "    '$clpfd_original_goal'(A, B, C).\n"
    "'$clpfd_attribute_goal_'(pdistinct(A), B, C) :-\n"
    "    B=[all_distinct(A)|C].\n"
    "'$clpfd_attribute_goal_'(pexclude(_, _, _), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(pelement(A, B, C), D, E) :-\n"
    "    D=[element(A, B, C)|E].\n"
    "'$clpfd_attribute_goal_'(pgcc(A, B, _), C, D) :-\n"
    "    C=[global_cardinality(A, B)|D].\n"
    "'$clpfd_attribute_goal_'(pgcc_single(_, _), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(pgcc_check_single(_), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(pgcc_check(_), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(pcircuit(A), B, C) :-\n"
    "    B=[circuit(A)|C].\n"
    "'$clpfd_attribute_goal_'(pserialized(_, _, _, _, A), B, C) :-\n"
    "    '$clpfd_original_goal'(A, B, C).\n"
    "'$clpfd_attribute_goal_'(rel_tuple(A, B), C, D) :-\n"
    "    get_attr(A, clpfd_relation, E),\n"
    "    F=C,\n"
    "    F=[tuples_in([B], E)|D].\n"
    "'$clpfd_attribute_goal_'(pzcompare(A, B, C), D, E) :-\n"
    "    D=[zcompare(A, B, C)|E].\n"
    "'$clpfd_attribute_goal_'(reified_in(A, B, C), D, E) :-\n"
    "    D=[A in F#<==> ?(C)|G],\n"
    "    '$clpfd_domain_to_drep'(B, F),\n"
    "    E=G.\n"
    "'$clpfd_attribute_goal_'(reified_tuple_in(A, B, C), D, E) :-\n"
    "    get_attr(B, clpfd_relation, F),\n"
    "    G=D,\n"
    "    G=[tuples_in([A], F)#<==> ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(kill_reified_tuples(_, _, _), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(tuples_not_in(_, _, _), A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_attribute_goal_'(reified_fd(A, B), C, D) :-\n"
    "    C=[finite_domain(A)#<==> ?(B)|D].\n"
    "'$clpfd_attribute_goal_'(pskeleton(A, B, C, _, D, E), F, G) :-\n"
    "    ( H=..[E, A, B, D],\n"
    "      '$clpfd_attribute_goal_'(H, I, []),\n"
    "      '$clpfd_list_goal'(I, J)\n"
    "    ),\n"
    "    K=F,\n"
    "    K=[?(C)#=1#==>J, ?(B)#\\=0#==> ?(C)#=1|G].\n"
    "'$clpfd_attribute_goal_'(reified_neq(A, B, C, D, _, E), F, G) :-\n"
    "    '$clpfd_conjunction'(A,\n"
    "                C,\n"
    "                ?(B)#\\= ?(D),\n"
    "                E,\n"
    "                F,\n"
    "                G).\n"
    "'$clpfd_attribute_goal_'(reified_eq(A, B, C, D, _, E), F, G) :-\n"
    "    '$clpfd_conjunction'(A,\n"
    "                C,\n"
    "                ?(B)#= ?(D),\n"
    "                E,\n"
    "                F,\n"
    "                G).\n"
