    "socket(D, S) :- '$gnu_b_ia'(D, socket/2), ( D == 'AF_UNIX' ; D == 'AF_INET' ), !, '$gnu_b_unbound'(S, socket/2), '$gnu_os'(sk_socket, D, S).\n"
