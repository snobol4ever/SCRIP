    "                C,\n"
    "                ?(B)#>= ?(D),\n"
    "                E,\n"
    "                F,\n"
    "                G).\n"
    "'$clpfd_attribute_goal_'(reified_and(A, _, B, _, C), D, E) :-\n"
    "    D=[?(A)#/\\ ?(B)#<==> ?(C)|E].\n"
    "'$clpfd_attribute_goal_'(reified_or(A, _, B, _, C), D, E) :-\n"
