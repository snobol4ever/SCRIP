    "    '$clpfd_scalar_plusterm'(L, O),\n"
    "    (   I=:=0\n"
    "    ->  C=O,\n"
    "        D=N\n"
    "    ;   N==0\n"
    "    ->  C=O,\n"
    "        D=J\n"
    "    ;   O==0\n"
    "    ->  C=I,\n"
    "        D=N\n"
    "    ;   I<0\n"
    "    ->  C=O,\n"
    "        D=N+J\n"
    "    ;   C=O+I,\n"
    "        D=N\n"
    "    ).\n"
