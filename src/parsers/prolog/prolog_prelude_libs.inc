    "'$clpfd_attribute_goal_'(pimpl(A, B, _), C, D) :-\n"
    "    C=[?(A)#==> ?(B)|D].\n"
    "'$clpfd_attribute_goal_'(pfunction(A, B, C, D), E, F) :-\n"
    "    G=..[A, ?(B), ?(C)],\n"
    "    H=E,\n"
    "    H=[?(D)#=G|F].\n"
    "'$clpfd_attribute_goal_'(pfunction(A, B, C), D, E) :-\n"
    "    F=..[A, ?(B)],\n"
    "    G=D,\n"
    "    G=[?(C)#=F|E].\n"
    "'$clpfd_conjunction'(A, B, C, D, E, F) :-\n"
    "    (   A==1,\n"
    "        B==1,\n"
    "        G=E\n"
    "    ->  G=[C#<==> ?(D)|F]\n"
    "    ;   A==1,\n"
    "        H=E\n"
    "    ->  H=[?(B)#/\\C#<==> ?(D)|F]\n"
    "    ;   B==1,\n"
    "        I=E\n"
    "    ->  I=[?(A)#/\\C#<==> ?(D)|F]\n"
    "    ;   E=[?(A)#/\\ ?(B)#/\\C#<==> ?(D)|F]\n"
    "    ).\n"
