    "        F=[B|D]\n"
    "    ;   C=D\n"
    "    ).\n"
    "'$clpfd_scalar_product_left_right'(A, B, C, D) :-\n"
    "    pairs_keys_values(E, A, B),\n"
    "    partition(ground, E, F, G),\n"
    "    maplist('$clpfd_pair_product', F, H),\n"
