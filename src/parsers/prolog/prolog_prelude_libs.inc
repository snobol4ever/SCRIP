    "                                ;   S=n(1),\n"
    "                                    T=sup\n"
    "                                )\n"
    "                              ),\n"
    "                              [P, Q, S, T]),\n"
    "        '$clpfd_cis_min'(P, S, U),\n"
    "        '$clpfd_cis_max'(U, E, G),\n"
    "        '$clpfd_cis_max'(Q, T, V),\n"
    "        '$clpfd_cis_min'(V, F, H)\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0),\n"
    "        '$clpfd_cis_lt_numeric'(C, 0),\n"
    "        '$clpfd_cis_gt_numeric'(D, 0),\n"
    "        '$clpfd_cis_lt_numeric'(E, 0),\n"
    "        '$clpfd_cis_gt_numeric'(F, 0)\n"
    "    ->  maplist('$clpfd_in_'(A, B), [I, J]),\n"
    "        '$clpfd_with_local_attributes'([K, L, M, N],\n"
    "                              [],\n"
    "                              ( '$clpfd_in_'(C, n(-1), K),\n"
    "                                '$clpfd_in_'(E, n(-1), L),\n"
    "                                (   (   integer(K),\n"
    "                                        integer(L)\n"
    "                                    ->  (   var(I)\n"
    "                                        ->  I is K*L\n"
    "                                        ;   integer(I)\n"
    "                                        ->  K*L=:=I\n"
    "                                        ;   W is K*L,\n"
    "                                            clpfd:'$clpfd_clpfd_equal'(W, I)\n"
    "                                        )\n"
    "                                    ;   integer(I)\n"
    "                                    ->  W=I,\n"
    "                                        clpfd:'$clpfd_clpfd_equal'(K*L, W)\n"
    "                                    ;   clpfd:'$clpfd_clpfd_equal'(K*L, I)\n"
    "                                    )\n"
    "                                ->  (   '$clpfd_fd_get'(L,\n"
    "                                               _,\n"
    "                                               P,\n"
    "                                               Q,\n"
    "                                               _)\n"
    "                                    ->  true\n"
    "                                    ;   P=n(L),\n"
    "                                        Q=n(L)\n"
    "                                    )\n"
    "                                ;   P=n(1),\n"
    "                                    Q=sup\n"
    "                                ),\n"
    "                                '$clpfd_in_'(n(1), D, M),\n"
    "                                '$clpfd_in_'(n(1), F, N),\n"
    "                                (   (   integer(M),\n"
    "                                        integer(N)\n"
    "                                    ->  (   var(J)\n"
    "                                        ->  J is M*N\n"
    "                                        ;   integer(J)\n"
    "                                        ->  M*N=:=J\n"
    "                                        ;   X is M*N,\n"
    "                                            clpfd:'$clpfd_clpfd_equal'(X, J)\n"
    "                                        )\n"
    "                                    ;   integer(J)\n"
    "                                    ->  X=J,\n"
    "                                        clpfd:'$clpfd_clpfd_equal'(M*N, X)\n"
    "                                    ;   clpfd:'$clpfd_clpfd_equal'(M*N, J)\n"
    "                                    )\n"
    "                                ->  (   '$clpfd_fd_get'(N,\n"
    "                                               _,\n"
    "                                               S,\n"
    "                                               T,\n"
    "                                               _)\n"
    "                                    ->  true\n"
    "                                    ;   S=n(N),\n"
    "                                        T=n(N)\n"
    "                                    )\n"
    "                                ;   S=inf,\n"
    "                                    T=n(-1)\n"
    "                                )\n"
    "                              ),\n"
    "                              [P, Q, S, T]),\n"
    "        '$clpfd_cis_min'(P, S, Y),\n"
    "        '$clpfd_cis_max'(Y, E, G),\n"
    "        '$clpfd_cis_max'(Q, T, Z),\n"
    "        '$clpfd_cis_min'(Z, F, H)\n"
    "    ;   '$clpfd_min_factor'(A, B, C, D, A1),\n"
    "        '$clpfd_cis_max'(E, A1, G),\n"
    "        '$clpfd_max_factor'(A, B, C, D, B1),\n"
    "        '$clpfd_cis_min'(F, B1, H)\n"
    "    ).\n"
    "'$clpfd_min_factor'(A, B, C, D, E) :-\n"
    "    (   '$clpfd_cis_geq_numeric'(A, 0),\n"
    "        '$clpfd_cis_gt_numeric'(C, 0),\n"
    "        '$clpfd_finite'(D)\n"
    "    ->  '$clpfd_cis_plus'(A, D, F),\n"
    "        '$clpfd_cis_minus'(F, n(1), G),\n"
    "        '$clpfd_cis_slash'(G, D, E)\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0),\n"
    "        '$clpfd_cis_lt_numeric'(D, 0)\n"
    "    ->  '$clpfd_cis_slash'(B, D, E)\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0),\n"
    "        '$clpfd_cis_geq_numeric'(C, 0)\n"
    "    ->  E=n(1)\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0)\n"
    "    ->  '$clpfd_cis_uminus'(B, E)\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0),\n"
    "        '$clpfd_cis_leq_numeric'(D, 0)\n"
    "    ->  (   '$clpfd_finite'(C)\n"
    "        ->  '$clpfd_cis_plus'(B, C, H),\n"
    "            '$clpfd_cis_plus'(H, n(1), I),\n"
    "            '$clpfd_cis_slash'(I, C, E)\n"
    "        ;   E=n(1)\n"
    "        )\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0),\n"
    "        '$clpfd_cis_geq_numeric'(C, 0)\n"
    "    ->  '$clpfd_cis_slash'(A, C, E)\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0)\n"
    "    ->  E=A\n"
    "    ;   '$clpfd_cis_leq_numeric'(C, 0),\n"
    "        '$clpfd_cis_geq_numeric'(D, 0)\n"
    "    ->  E=inf\n"
    "    ;   ( ( '$clpfd_cis_slash'(A, C, J),\n"
    "            '$clpfd_cis_slash'(A, D, K),\n"
    "            '$clpfd_cis_min'(J, K, L)\n"
    "          ),\n"
    "          '$clpfd_cis_slash'(B, C, M),\n"
    "          '$clpfd_cis_slash'(B, D, N)\n"
    "        ),\n"
    "        '$clpfd_cis_min'(M, N, O),\n"
    "        '$clpfd_cis_min'(L, O, E)\n"
    "    ).\n"
    "'$clpfd_max_factor'(A, B, C, D, E) :-\n"
    "    (   '$clpfd_cis_geq_numeric'(A, 0),\n"
    "        '$clpfd_cis_geq_numeric'(C, 0)\n"
    "    ->  '$clpfd_cis_slash'(B, C, E)\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0),\n"
    "        '$clpfd_cis_leq_numeric'(D, 0)\n"
    "    ->  (   '$clpfd_finite'(C)\n"
    "        ->  '$clpfd_cis_minus'(A, C, F),\n"
    "            '$clpfd_cis_minus'(F, n(1), G),\n"
    "            '$clpfd_cis_slash'(G, C, E)\n"
    "        ;   E=n(-1)\n"
    "        )\n"
    "    ;   '$clpfd_cis_gt_numeric'(A, 0)\n"
    "    ->  E=B\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0),\n"
    "        '$clpfd_cis_lt_numeric'(D, 0)\n"
    "    ->  '$clpfd_cis_slash'(A, D, E)\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0),\n"
    "        '$clpfd_cis_geq_numeric'(C, 0)\n"
    "    ->  (   '$clpfd_finite'(D)\n"
    "        ->  '$clpfd_cis_minus'(B, D, H),\n"
    "            '$clpfd_cis_plus'(H, n(1), I),\n"
    "            '$clpfd_cis_slash'(I, D, E)\n"
    "        ;   E=n(-1)\n"
    "        )\n"
    "    ;   '$clpfd_cis_lt_numeric'(B, 0)\n"
    "    ->  '$clpfd_cis_uminus'(A, E)\n"
    "    ;   '$clpfd_cis_leq_numeric'(C, 0),\n"
    "        '$clpfd_cis_geq_numeric'(D, 0)\n"
    "    ->  E=sup\n"
    "    ;   ( ( '$clpfd_cis_slash'(A, C, J),\n"
    "            '$clpfd_cis_slash'(A, D, K),\n"
    "            '$clpfd_cis_max'(J, K, L)\n"
    "          ),\n"
    "          '$clpfd_cis_slash'(B, C, M),\n"
    "          '$clpfd_cis_slash'(B, D, N)\n"
    "        ),\n"
    "        '$clpfd_cis_max'(M, N, O),\n"
    "        '$clpfd_cis_max'(L, O, E)\n"
    "    ).\n"
    "'$clpfd_distinct_attach'([], _, _).\n"
    "'$clpfd_distinct_attach'([A|B], C, D) :-\n"
    "    (   var(A)\n"
    "    ->  '$clpfd_init_propagator'(A, C),\n"
    "        '$clpfd_make_propagator'(pexclude(B, D, A), E),\n"
    "        '$clpfd_init_propagator'(A, E),\n"
    "        '$clpfd_trigger_prop'(E)\n"
    "    ;   '$clpfd_exclude_fire'(B, D, A)\n"
    "    ),\n"
    "    '$clpfd_distinct_attach'(B, C, [A|D]).\n"
    "'$clpfd_difference_arcs'(A, B, C) :-\n"
    "    empty_assoc(D),\n"
    "    '$clpfd_difference_arcs'(A, B, [D], [E]),\n"
    "    assoc_to_list(E, F),\n"
    "    pairs_values(F, C).\n"
    "'$clpfd_domain_to_list'(A, B) :-\n"
    "    '$clpfd_domain_to_list'(A, B, []).\n"
    "'$clpfd_domain_to_list'(split(_, A, B), C, D) :-\n"
    "    '$clpfd_domain_to_list'(A, C, E),\n"
    "    '$clpfd_domain_to_list'(B, E, D).\n"
    "'$clpfd_domain_to_list'(empty, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_domain_to_list'(from_to(n(A), n(B)), C, D) :-\n"
    "    numlist(A, B, E),\n"
    "    F=C,\n"
    "    '$clpfd_list'(E, F, D).\n"
    "'$clpfd_difference_arcs'([], [], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_difference_arcs'([A|B], C, D, E) :-\n"
    "    (   '$clpfd_fd_get'(A, F, _),\n"
    "        '$clpfd_finite_domain'(F),\n"
    "        G=D\n"
    "    ->  ( C=[A|H],\n"
    "          '$clpfd_domain_to_list'(F, I)\n"
    "        ),\n"
    "        J=G,\n"
    "        '$clpfd_enumerate'(I, A, J, K),\n"
    "        '$clpfd_difference_arcs'(B, H, K, E)\n"
    "    ;   '$clpfd_difference_arcs'(B, C, D, E)\n"
    "    ).\n"
    "'$clpfd_enumerate'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_enumerate'([A|B], C, D, E) :-\n"
    "    '$clpfd_state'(F, G, D, H),\n"
    "    ( (   get_assoc(A, F, I)\n"
    "      ->  F=G\n"
    "      ;   put_assoc(A, F, I, G),\n"
    "          put_attr(I, value, A)\n"
    "      ),\n"
    "      put_attr(J, flow, 0),\n"
    "      '$clpfd_append_edge'(I, edges, flow_from(J, C)),\n"
    "      '$clpfd_append_edge'(C, edges, flow_to(J, I))\n"
    "    ),\n"
    "    K=H,\n"
    "    '$clpfd_enumerate'(B, C, K, E).\n"
    "'$clpfd_append_edge'(A, B, C) :-\n"
    "    (   get_attr(A, B, D)\n"
    "    ->  put_attr(A, B, [C|D])\n"
    "    ;   put_attr(A, B, [C])\n"
    "    ).\n"
    "'$clpfd_clear_parent'(A) :-\n"
    "    del_attr(A, parent).\n"
    "'$clpfd_maximum_matching'([]).\n"
    "'$clpfd_maximum_matching'([A|B]) :-\n"
    "    '$clpfd_augmenting_path_to'([[A]], C, D),\n"
    "    '$clpfd_augmenting_path'(A, D, E, []),\n"
    "    maplist(maplist('$clpfd_clear_parent'), C),\n"
    "    del_attr(D, free),\n"
    "    '$clpfd_adjust_alternate_1'(E),\n"
    "    '$clpfd_maximum_matching'(B).\n"
    "'$clpfd_reachables'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_reachables'([A|B], C, D) :-\n"
    "    get_attr(A, edges, E),\n"
    "    F=C,\n"
    "    '$clpfd_reachables_'(E, A, F, G),\n"
    "    '$clpfd_reachables'(B, G, D).\n"
    "'$clpfd_reachables_'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_reachables_'([A|B], C, D, E) :-\n"
    "    '$clpfd_edge_reachable'(A, C, D, F),\n"
    "    '$clpfd_reachables_'(B, C, F, E).\n"
    "'$clpfd_edge_reachable'(flow_to(A, B), C, D, E) :-\n"
    "    (   get_attr(A, flow, 0),\n"
    "        \\+ get_attr(B, parent, _),\n"
    "        F=D\n"
    "    ->  put_attr(B, parent, C-A),\n"
    "        G=F,\n"
    "        G=[B|E]\n"
    "    ;   D=E\n"
    "    ).\n"
    "'$clpfd_edge_reachable'(flow_from(A, B), C, D, E) :-\n"
    "    (   get_attr(A, flow, 1),\n"
    "        \\+ get_attr(B, parent, _),\n"
    "        F=D\n"
    "    ->  put_attr(B, parent, C-A),\n"
    "        G=F,\n"
    "        G=[B|E]\n"
    "    ;   D=E\n"
    "    ).\n"
    "'$clpfd_augmenting_path_to'(A, B, C) :-\n"
    "    A=[D|_],\n"
    "    E=[F|A],\n"
    "    '$clpfd_reachables'(D, F, []),\n"
    "    F=[_|_],\n"
    "    (   member(C, F),\n"
    "        get_attr(C, free, true)\n"
    "    ->  B=E\n"
    "    ;   '$clpfd_augmenting_path_to'(E, B, C)\n"
    "    ).\n"
    "'$clpfd_augmenting_path'(A, B, C, D) :-\n"
    "    (   B==A,\n"
    "        E=C\n"
    "    ->  E=D\n"
    "    ;   get_attr(B, parent, F-G),\n"
    "        H=C,\n"
    "        H=[G|I],\n"
    "        '$clpfd_augmenting_path'(A, F, I, D)\n"
    "    ).\n"
    "'$clpfd_adjust_alternate_1'([A|B]) :-\n"
    "    put_attr(A, flow, 1),\n"
    "    '$clpfd_adjust_alternate_0'(B).\n"
    "'$clpfd_adjust_alternate_0'([]).\n"
    "'$clpfd_adjust_alternate_0'([A|B]) :-\n"
    "    put_attr(A, flow, 0),\n"
    "    '$clpfd_adjust_alternate_1'(B).\n"
    "'$clpfd_g_g0'(A) :-\n"
    "    get_attr(A, edges, B),\n"
    "    maplist('$clpfd_g_g0_'(A), B).\n"
    "'$clpfd_g_g0_'(A, flow_to(B, C)) :-\n"
    "    (   get_attr(B, flow, 1)\n"
    "    ->  '$clpfd_append_edge'(A, g0_edges, flow_to(B, C))\n"
    "    ;   '$clpfd_append_edge'(C, g0_edges, flow_to(B, A))\n"
    "    ).\n"
    "'$clpfd_g0_successors'(A, B) :-\n"
    "    (   get_attr(A, g0_edges, C)\n"
    "    ->  maplist(arg(2), C, B)\n"
    "    ;   B=[]\n"
    "    ).\n"
    "'$clpfd_put_free'(A) :-\n"
    "    put_attr(A, free, true).\n"
    "'$clpfd_free_node'(A) :-\n"
    "    get_attr(A, free, true).\n"
    "'$clpfd_del_vars_attr'(A, B) :-\n"
    "    maplist('$clpfd_del_attr_'(B), A).\n"
    "'$clpfd_del_attr_'(A, B) :-\n"
    "    del_attr(B, A).\n"
    "'$clpfd_with_local_attributes'(A, B, C, D) :-\n"
    "    catch(( maplist('$clpfd_del_vars_attr'(A), B),\n"
    "            C,\n"
    "            maplist(del_attrs, A),\n"
    "            throw(local_attributes(D, A))\n"
    "          ),\n"
    "          local_attributes(D, A),\n"
    "          true).\n"
    "'$clpfd_distinct'(A) :-\n"
    "    '$clpfd_with_local_attributes'(A,\n"
    "                          [edges, parent, g0_edges, index, visited],\n"
    "                          ( '$clpfd_difference_arcs'(A, B, C),\n"
    "                            length(B, D),\n"
    "                            length(C, E),\n"
    "                            D=<E,\n"
    "                            maplist('$clpfd_put_free', C),\n"
    "                            '$clpfd_maximum_matching'(B),\n"
    "                            include('$clpfd_free_node', C, F),\n"
    "                            maplist('$clpfd_g_g0', B),\n"
    "                            '$clpfd_scc'(B, '$clpfd_g0_successors'),\n"
    "                            maplist('$clpfd_dfs_used', F),\n"
    "                            '$clpfd_distinct_goals'(B, G, [])\n"
    "                          ),\n"
    "                          G),\n"
    "    '$clpfd_disable_queue',\n"
    "    maplist(call, G),\n"
    "    '$clpfd_enable_queue'.\n"
    "'$clpfd_distinct_goals'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_distinct_goals'([A|B], C, D) :-\n"
    "    get_attr(A, edges, E),\n"
    "    F=C,\n"
    "    '$clpfd_distinct_goals_'(E, A, F, G),\n"
    "    '$clpfd_distinct_goals'(B, G, D).\n"
    "'$clpfd_distinct_goals_'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_distinct_goals_'([flow_to(A, B)|C], D, E, F) :-\n"
    "    (   get_attr(A, flow, 0),\n"
    "        \\+ get_attr(A, used, true),\n"
    "        get_attr(D, lowlink, G),\n"
    "        get_attr(B, lowlink, H),\n"
    "        G=\\=H,\n"
    "        I=E\n"
    "    ->  get_attr(B, value, J),\n"
    "        K=I,\n"
    "        K=['$clpfd_neq_num'(D, J)|L]\n"
    "    ;   E=L\n"
    "    ),\n"
    "    '$clpfd_distinct_goals_'(C, D, L, F).\n"
    "'$clpfd_dfs_used'(A) :-\n"
    "    (   get_attr(A, visited, true)\n"
    "    ->  true\n"
    "    ;   put_attr(A, visited, true),\n"
    "        (   get_attr(A, g0_edges, B)\n"
    "        ->  '$clpfd_dfs_used_edges'(B)\n"
    "        ;   true\n"
    "        )\n"
    "    ).\n"
    "'$clpfd_dfs_used_edges'([]).\n"
    "'$clpfd_dfs_used_edges'([flow_to(A, B)|C]) :-\n"
    "    put_attr(A, used, true),\n"
    "    '$clpfd_dfs_used'(B),\n"
    "    '$clpfd_dfs_used_edges'(C).\n"
    "'$clpfd_scc'(A, B) :-\n"
    "    '$clpfd_scc'(A, [s(0, [], B)], _).\n"
    "'$clpfd_scc'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_scc'([A|B], C, D) :-\n"
    "    (   '$clpfd_vindex_defined'(A, C, E)\n"
    "    ->  '$clpfd_scc'(B, E, D)\n"
    "    ;   '$clpfd_scc_'(A, C, F),\n"
    "        '$clpfd_scc'(B, F, D)\n"
    "    ).\n"
    "'$clpfd_vindex_defined'(A, B, C) :-\n"
    "    get_attr(A, index, _),\n"
    "    C=B.\n"
    "'$clpfd_vindex_is_index'(A, B, C) :-\n"
    "    '$clpfd_state'(s(D, _, _), B, E),\n"
    "    put_attr(A, index, D),\n"
    "    C=E.\n"
    "'$clpfd_vlowlink_is_index'(A, B, C) :-\n"
    "    '$clpfd_state'(s(D, _, _), B, E),\n"
    "    put_attr(A, lowlink, D),\n"
    "    C=E.\n"
    "'$clpfd_index_plus_one'(A, B) :-\n"
    "    '$clpfd_state'(s(C, D, E),\n"
    "          s(F, D, E),\n"
    "          A,\n"
    "          G),\n"
    "    F is C+1,\n"
    "    B=G.\n"
    "'$clpfd_s_push'(A, B, C) :-\n"
    "    '$clpfd_state'(s(D, E, F),\n"
    "          s(D, [A|E], F),\n"
    "          B,\n"
    "          G),\n"
    "    put_attr(A, in_stack, true),\n"
    "    C=G.\n"
    "'$clpfd_vlowlink_min_lowlink'(A, B, C, D) :-\n"
    "    get_attr(A, lowlink, E),\n"
    "    get_attr(B, lowlink, F),\n"
    "    G is min(E, F),\n"
    "    put_attr(A, lowlink, G),\n"
    "    D=C.\n"
    "'$clpfd_successors'(A, B, C, D) :-\n"
    "    '$clpfd_state'(s(_, _, E), C, F),\n"
    "    call(E, A, B),\n"
    "    D=F.\n"
    "'$clpfd_scc_'(A, B, C) :-\n"
    "    '$clpfd_vindex_is_index'(A, B, D),\n"
    "    '$clpfd_vlowlink_is_index'(A, D, E),\n"
    "    '$clpfd_index_plus_one'(E, F),\n"
    "    '$clpfd_s_push'(A, F, G),\n"
    "    '$clpfd_successors'(A, H, G, I),\n"
    "    '$clpfd_each_edge'(H, A, I, J),\n"
    "    (   get_attr(A, index, K),\n"
    "        get_attr(A, lowlink, K),\n"
    "        L=J\n"
    "    ->  '$clpfd_pop_stack_to'(A, K, L, C)\n"
    "    ;   J=C\n"
    "    ).\n"
    "'$clpfd_pop_stack_to'(A, B, C, D) :-\n"
    "    '$clpfd_state'(s(E, [F|G], H),\n"
    "          s(E, G, H),\n"
    "          C,\n"
    "          I),\n"
    "    del_attr(F, in_stack),\n"
    "    J=I,\n"
    "    (   F==A,\n"
    "        K=J\n"
    "    ->  K=D\n"
    "    ;   put_attr(F, lowlink, B),\n"
    "        L=J,\n"
    "        '$clpfd_pop_stack_to'(A, B, L, D)\n"
    "    ).\n"
    "'$clpfd_each_edge'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_each_edge'([A|B], C, D, E) :-\n"
    "    (   '$clpfd_vindex_defined'(A, D, F)\n"
    "    ->  (   '$clpfd_v_in_stack'(A, F, G)\n"
    "        ->  '$clpfd_vlowlink_min_lowlink'(C, A, G, H)\n"
    "        ;   F=H\n"
    "        )\n"
    "    ;   '$clpfd_scc_'(A, D, I),\n"
    "        '$clpfd_vlowlink_min_lowlink'(C, A, I, H)\n"
    "    ),\n"
    "    '$clpfd_each_edge'(B, C, H, E).\n"
    "'$clpfd_state'(A, B, C) :-\n"
    "    B=[A|D],\n"
    "    C=[A|D].\n"
    "'$clpfd_state'(A, B, C, D) :-\n"
    "    C=[A|E],\n"
    "    D=[B|E].\n"
    "'$clpfd_v_in_stack'(A, B, C) :-\n"
    "    get_attr(A, in_stack, true),\n"
    "    C=B.\n"
    "'$clpfd_weak_arc_all_distinct'(A) :-\n"
    "    must_be(list, A),\n"
    "    B=original_goal(_, weak_arc_all_distinct(A)),\n"
    "    '$clpfd_all_distinct'(A, [], B),\n"
    "    '$clpfd_do_queue'.\n"
    "'$clpfd_all_distinct'([], _, _).\n"
    "'$clpfd_all_distinct'([A|B], C, D) :-\n"
    "    (   var(A)\n"
    "    ->  '$clpfd_make_propagator'(weak_distinct(C, B, A, D),\n"
    "                        E),\n"
    "        '$clpfd_init_propagator'(A, E),\n"
    "        '$clpfd_trigger_prop'(E)\n"
    "    ;   '$clpfd_exclude_fire'(C, B, A)\n"
    "    ),\n"
    "    '$clpfd_outof_reducer'(C, B, A),\n"
    "    '$clpfd_all_distinct'(B, [A|C], D).\n"
    "'$clpfd_exclude_fire'(A, B, C) :-\n"
    "    '$clpfd_all_neq'(A, C),\n"
    "    '$clpfd_all_neq'(B, C).\n"
    "'$clpfd_list_contains'([A|B], C) :-\n"
    "    (   A==C\n"
    "    ->  true\n"
    "    ;   '$clpfd_list_contains'(B, C)\n"
    "    ).\n"
    "'$clpfd_kill_if_isolated'(A, B, C, D) :-\n"
    "    append(A, B, E),\n"
    "    '$clpfd_fd_get'(C, F, _),\n"
    "    (   '$clpfd_all_empty_intersection'(E, F)\n"
    "    ->  '$clpfd_kill'(D)\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_all_empty_intersection'([], _).\n"
    "'$clpfd_all_empty_intersection'([A|B], C) :-\n"
    "    (   '$clpfd_fd_get'(A, D, _)\n"
    "    ->  '$clpfd_domains_intersection_'(D, C, empty),\n"
    "        '$clpfd_all_empty_intersection'(B, C)\n"
    "    ;   '$clpfd_all_empty_intersection'(B, C)\n"
    "    ).\n"
    "'$clpfd_outof_reducer'(A, B, C) :-\n"
    "    (   '$clpfd_fd_get'(C, D, _)\n"
    "    ->  append(A, B, E),\n"
    "        '$clpfd_domain_num_elements'(D, F),\n"
    "        '$clpfd_num_subsets'(E, D, 0, G, H),\n"
    "        (   '$clpfd_cis_leq_numeric'(F, G)\n"
    "        ->  false\n"
    "        ;   '$clpfd_cis_minus'(F, n(1), n(G))\n"
    "        ->  '$clpfd_reduce_from_others'(H, D)\n"
    "        ;   true\n"
    "        )\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_reduce_from_others'([], _).\n"
    "'$clpfd_reduce_from_others'([A|B], C) :-\n"
    "    (   '$clpfd_fd_get'(A, D, E)\n"
    "    ->  '$clpfd_domain_subtract'(D, C, F),\n"
    "        '$clpfd_fd_put'(A, F, E)\n"
    "    ;   true\n"
    "    ),\n"
    "    '$clpfd_reduce_from_others'(B, C).\n"
    "'$clpfd_num_subsets'([], _, A, A, []).\n"
    "'$clpfd_num_subsets'([A|B], C, D, E, F) :-\n"
    "    (   '$clpfd_fd_get'(A, G, _)\n"
    "    ->  (   '$clpfd_domain_subdomain'(C, G)\n"
    "        ->  H is D+1,\n"
    "            '$clpfd_num_subsets'(B, C, H, E, F)\n"
    "        ;   F=[A|I],\n"
    "            '$clpfd_num_subsets'(B, C, D, E, I)\n"
    "        )\n"
    "    ;   '$clpfd_num_subsets'(B, C, D, E, F)\n"
    "    ).\n"
    "serialized(A, B) :-\n"
    "    must_be(list(integer), B),\n"
    "    pairs_keys_values(C, A, B),\n"
    "    D=original_goal(_, serialized(A, B)),\n"
    "    '$clpfd_serialize'(C, D).\n"
    "'$clpfd_serialize'([], _).\n"
    "'$clpfd_serialize'([A-B|C], D) :-\n"
    "    B>=0,\n"
    "    '$clpfd_serialize'(C, A, B, D),\n"
    "    '$clpfd_serialize'(C, D).\n"
    "'$clpfd_serialize'([], _, _, _).\n"
    "'$clpfd_serialize'([A-B|C], D, E, F) :-\n"
    "    B>=0,\n"
    "    '$clpfd_propagator_init_trigger'([D, A],\n"
    "                            pserialized(A,\n"
    "                                        B,\n"
    "                                        D,\n"
    "                                        E,\n"
    "                                        F)),\n"
    "    '$clpfd_serialize'(C, D, E, F).\n"
    "'$clpfd_earliest_start_time'(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_infimum'(C, B)\n"
    "    ;   B=n(A)\n"
    "    ).\n"
    "'$clpfd_latest_start_time'(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, C, _)\n"
    "    ->  '$clpfd_domain_supremum'(C, B)\n"
    "    ;   B=n(A)\n"
    "    ).\n"
    "'$clpfd_serialize_lower_upper'(A, B, C, D, E) :-\n"
    "    (   var(A)\n"
    "    ->  '$clpfd_serialize_lower_bound'(A,\n"
    "                              B,\n"
    "                              C,\n"
    "                              D,\n"
    "                              E),\n"
    "        (   var(A)\n"
    "        ->  '$clpfd_serialize_upper_bound'(A,\n"
    "                                  B,\n"
    "                                  C,\n"
    "                                  D,\n"
    "                                  E)\n"
    "        ;   true\n"
    "        )\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_serialize_lower_bound'(A, B, C, D, E) :-\n"
    "    '$clpfd_fd_get'(A, F, G),\n"
    "    (   '$clpfd_domain_infimum'(F, n(H)),\n"
    "        '$clpfd_latest_start_time'(C, n(I)),\n"
    "        H+B>I,\n"
    "        '$clpfd_earliest_start_time'(C, n(J))\n"
    "    ->  (   nonvar(C)\n"
    "        ->  '$clpfd_kill'(E)\n"
    "        ;   true\n"
    "        ),\n"
    "        K is J+D,\n"
    "        '$clpfd_domain_remove_smaller_than'(F, K, L),\n"
    "        '$clpfd_fd_put'(A, L, G)\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_serialize_upper_bound'(A, B, C, D, E) :-\n"
    "    '$clpfd_fd_get'(A, F, G),\n"
    "    (   '$clpfd_domain_supremum'(F, n(H)),\n"
    "        '$clpfd_earliest_start_time'(C, n(I)),\n"
    "        I+D>H,\n"
    "        '$clpfd_latest_start_time'(C, n(J))\n"
    "    ->  (   nonvar(C)\n"
    "        ->  '$clpfd_kill'(E)\n"
    "        ;   true\n"
    "        ),\n"
    "        K is J-B,\n"
    "        '$clpfd_domain_remove_greater_than'(F, K, L),\n"
    "        '$clpfd_fd_put'(A, L, G)\n"
    "    ;   true\n"
    "    ).\n"
    "element(A, B, C) :-\n"
    "    must_be(list, B),\n"
    "    length(B, D),\n"
    "    clpfd:'$clpfd_clpfd_in'(A, 1..D),\n"
    "    '$clpfd_element_'(B, 1, A, C),\n"
    "    '$clpfd_propagator_init_trigger'([A|B],\n"
    "                            pelement(A, B, C)).\n"
    "'$clpfd_element_domain'(A, B) :-\n"
    "    (   '$clpfd_fd_get'(A, B, _)\n"
    "    ->  true\n"
    "    ;   B=from_to(n(A), n(A))\n"
    "    ).\n"
    "'$clpfd_element_'([], _, _, _).\n"
    "'$clpfd_element_'([A|B], C, D, E) :-\n"
    "    ?(A)#\\= ?(E)#==> ?(D)#\\=C,\n"
    "    F is C+1,\n"
    "    '$clpfd_element_'(B, F, D, E).\n"
    "'$clpfd_integers_remaining'([], _, _, A, A).\n"
    "'$clpfd_integers_remaining'([A|B], C, D, E, F) :-\n"
    "    (   '$clpfd_domain_contains'(D, C)\n"
    "    ->  '$clpfd_element_domain'(A, G),\n"
    "        '$clpfd_domains_union'(E, G, H)\n"
    "    ;   H=E\n"
    "    ),\n"
    "    I is C+1,\n"
    "    '$clpfd_integers_remaining'(B, I, D, H, F).\n"
    "global_cardinality(A, B) :-\n"
    "    global_cardinality(A, B, []).\n"
    "global_cardinality(A, B, C) :-\n"
    "    must_be(list(list), [A, B, C]),\n"
    "    maplist('$clpfd_fd_variable', A),\n"
    "    maplist('$clpfd_gcc_pair', B),\n"
    "    pairs_keys_values(B, D, E),\n"
    "    (   sort(D, F),\n"
    "        same_length(D, F)\n"
    "    ->  true\n"
    "    ;   domain_error(gcc_unique_key_pairs, B)\n"
    "    ),\n"
    "    length(A, G),\n"
    "    E ins 0..G,\n"
    "    '$clpfd_list_to_drep'(D, H),\n"
    "    A ins H,\n"
    "    '$clpfd_gcc_pairs'(B, A, I),\n"
    "    '$clpfd_propagator_init_trigger'(A, pgcc_check(I)),\n"
    "    '$clpfd_propagator_init_trigger'(E, pgcc_check_single(I)),\n"
    "    (   member(J, C),\n"
    "        J==consistency(value)\n"
    "    ->  true\n"
    "    ;   '$clpfd_propagator_init_trigger'(E, pgcc_single(A, I)),\n"
    "        '$clpfd_propagator_init_trigger'(A, pgcc(A, B, I))\n"
    "    ),\n"
    "    (   member(K, C),\n"
    "        functor(K, cost, 2)\n"
    "    ->  K=cost(L, M),\n"
    "        must_be(list(list(integer)), M),\n"
    "        maplist('$clpfd_keys_costs'(D), A, M, N),\n"
    "        sum(N, #=, L)\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_keys_costs'(A, B, C, D) :-\n"
    "    element(E, A, B),\n"
    "    element(E, C, D).\n"
    "'$clpfd_gcc_pair'(A) :-\n"
    "    (   A=B-C\n"
    "    ->  must_be(integer, B),\n"
    "        '$clpfd_fd_variable'(C)\n"
    "    ;   domain_error(gcc_pair, A)\n"
    "    ).\n"
    "'$clpfd_gcc_pairs'([], _, []).\n"
    "'$clpfd_gcc_pairs'([A-B|C], D, [A-E|F]) :-\n"
    "    put_attr(E, clpfd_gcc_num, B),\n"
    "    put_attr(E, clpfd_gcc_vs, D),\n"
    "    put_attr(E, clpfd_gcc_occurred, 0),\n"
    "    '$clpfd_gcc_pairs'(C, D, F).\n"
    "'$clpfd_gcc_global'(A, B) :-\n"
    "    '$clpfd_gcc_check'(B),\n"
    "    '$clpfd_do_queue',\n"
    "    '$clpfd_with_local_attributes'(A,\n"
    "                          [edges, parent, index],\n"
    "                          ( '$clpfd_gcc_arcs'(B, C, D),\n"
    "                            '$clpfd_variables_with_num_occurrences'(A,\n"
    "                                                           E),\n"
    "                            maplist('$clpfd_target_to_v'(F), E),\n"
    "                            (   get_attr(C, edges, G)\n"
    "                            ->  put_attr(C, parent, none),\n"
    "                                '$clpfd_feasible_flow'(G, C, F),\n"
    "                                '$clpfd_maximum_flow'(C, F),\n"
    "                                '$clpfd_gcc_consistent'(F),\n"
    "                                '$clpfd_scc'(D, '$clpfd_gcc_successors'),\n"
    "                                '$clpfd_gcc_goals'(D, H, [])\n"
    "                            ;   H=[]\n"
    "                            )\n"
    "                          ),\n"
    "                          H),\n"
    "    '$clpfd_disable_queue',\n"
    "    maplist(call, H),\n"
    "    '$clpfd_enable_queue'.\n"
    "'$clpfd_gcc_consistent'(A) :-\n"
    "    get_attr(A, edges, B),\n"
    "    maplist('$clpfd_saturated_arc', B).\n"
    "'$clpfd_saturated_arc'(arc_from(_, A, _, B)) :-\n"
    "    get_attr(B, flow, A).\n"
    "'$clpfd_gcc_goals'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_gcc_goals'([A|B], C, D) :-\n"
    "    get_attr(A, edges, E),\n"
    "    F=C,\n"
    "    '$clpfd_gcc_edges_goals'(E, A, F, G),\n"
    "    '$clpfd_gcc_goals'(B, G, D).\n"
    "'$clpfd_gcc_edges_goals'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_gcc_edges_goals'([A|B], C, D, E) :-\n"
    "    '$clpfd_gcc_edge_goal'(A, C, D, F),\n"
    "    '$clpfd_gcc_edges_goals'(B, C, F, E).\n"
    "'$clpfd_gcc_edge_goal'(arc_from(_, _, _, _), _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_gcc_edge_goal'(arc_to(_, _, A, B), C, D, E) :-\n"
    "    (   get_attr(B, flow, 0),\n"
    "        get_attr(A, lowlink, F),\n"
    "        get_attr(C, lowlink, G),\n"
    "        F=\\=G,\n"
    "        get_attr(C, value, H),\n"
    "        I=D\n"
    "    ->  I=['$clpfd_neq_num'(A, H)|E]\n"
    "    ;   D=E\n"
    "    ).\n"
    "'$clpfd_maximum_flow'(A, B) :-\n"
    "    (   '$clpfd_gcc_augmenting_path'([[A]], C, B)\n"
    "    ->  '$clpfd_augmenting_path'(A, B, D, []),\n"
    "        D=[augment(_, E, _)|F],\n"
    "        '$clpfd_path_minimum'(F, E, G),\n"
    "        maplist('$clpfd_gcc_augment'(G), D),\n"
    "        maplist(maplist('$clpfd_clear_parent'), C),\n"
    "        '$clpfd_maximum_flow'(A, B)\n"
    "    ;   true\n"
    "    ).\n"
    "'$clpfd_feasible_flow'([], _, _).\n"
    "'$clpfd_feasible_flow'([A|B], C, D) :-\n"
    "    '$clpfd_make_arc_feasible'(A, C, D),\n"
    "    '$clpfd_feasible_flow'(B, C, D).\n"
    "'$clpfd_make_arc_feasible'(A, B, C) :-\n"
    "    A=arc_to(D, _, E, F),\n"
    "    get_attr(F, flow, G),\n"
    "    (   G>=D\n"
    "    ->  true\n"
    "    ;   H is D-G,\n"
    "        put_attr(E, parent, B-augment(F, H, +)),\n"
    "        '$clpfd_gcc_augmenting_path'([[E]], I, C),\n"
    "        '$clpfd_augmenting_path'(B, C, J, []),\n"
    "        '$clpfd_path_minimum'(J, H, K),\n"
    "        maplist('$clpfd_gcc_augment'(K), J),\n"
    "        maplist(maplist('$clpfd_clear_parent'), I),\n"
    "        '$clpfd_make_arc_feasible'(A, B, C)\n"
    "    ).\n"
    "'$clpfd_gcc_augmenting_path'(A, B, C) :-\n"
    "    A=[D|_],\n"
    "    E=[F|A],\n"
    "    '$clpfd_gcc_reachables'(D, F, []),\n"
    "    F=[_|_],\n"
    "    (   member(G, F),\n"
    "        G==C\n"
    "    ->  B=E\n"
    "    ;   '$clpfd_gcc_augmenting_path'(E, B, C)\n"
    "    ).\n"
    "'$clpfd_gcc_reachables'([], A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_gcc_reachables'([A|B], C, D) :-\n"
    "    get_attr(A, edges, E),\n"
    "    F=C,\n"
    "    '$clpfd_gcc_reachables_'(E, A, F, G),\n"
    "    '$clpfd_gcc_reachables'(B, G, D).\n"
    "'$clpfd_gcc_reachables_'([], _, A, B) :-\n"
    "    A=B.\n"
    "'$clpfd_gcc_reachables_'([A|B], C, D, E) :-\n"
    "    '$clpfd_gcc_reachable'(A, C, D, F),\n"
    "    '$clpfd_gcc_reachables_'(B, C, F, E).\n"
    "'$clpfd_gcc_reachable'(arc_from(_, _, A, B), C, D, E) :-\n"
    "    (   \\+ get_attr(A, parent, _),\n"
    "        get_attr(B, flow, F),\n"
    "        F>0,\n"
    "        G=D\n"
    "    ->  put_attr(A, parent, C-augment(B, F, -)),\n"
    "        H=G,\n"
    "        H=[A|E]\n"
    "    ;   D=E\n"
    "    ).\n"
    "'$clpfd_gcc_reachable'(arc_to(_, A, B, C), D, E, F) :-\n"
    "    (   \\+ get_attr(B, parent, _),\n"
    "        get_attr(C, flow, G),\n"
    "        G<A,\n"
    "        H=E\n"
    "    ->  ( I is A-G,\n"
    "          put_attr(B, parent, D-augment(C, I, +))\n"
    "        ),\n"
    "        J=H,\n"
    "        J=[B|F]\n"
    "    ;   E=F\n"
    "    ).\n"
    "'$clpfd_path_minimum'([], A, A).\n"
    "'$clpfd_path_minimum'([augment(_, A, _)|B], C, D) :-\n"
    "    E is min(C, A),\n"
    "    '$clpfd_path_minimum'(B, E, D).\n"
    "'$clpfd_gcc_augment'(A, augment(B, _, C)) :-\n"
    "    get_attr(B, flow, D),\n"
    "    '$clpfd_gcc_flow_'(C, D, A, E),\n"
    "    put_attr(B, flow, E).\n"
    "'$clpfd_gcc_flow_'(+, A, B, C) :-\n"
    "    C is A+B.\n"
    "'$clpfd_gcc_flow_'(-, A, B, C) :-\n"
    "    C is A-B.\n"
    "'$clpfd_gcc_arcs'([], _, []).\n"
    "'$clpfd_gcc_arcs'([A-B|C], D, E) :-\n"
    "    (   get_attr(B, clpfd_gcc_vs, F)\n"
    "    ->  get_attr(B, clpfd_gcc_num, G),\n"
    "        get_attr(B, clpfd_gcc_occurred, H),\n"
    "        (   nonvar(G)\n"
    "        ->  I is G-H,\n"
    "            I=J\n"
    "        ;   '$clpfd_fd_get'(G,\n"
    "                   _,\n"
    "                   n(K),\n"
    "                   n(L),\n"
    "                   _),\n"
    "            J is K-H,\n"
    "            I is L-H\n"
    "        ),\n"
    "        put_attr(M, value, A),\n"
    "        E=[M|N],\n"
    "        put_attr(O, flow, 0),\n"
    "        '$clpfd_append_edge'(D,\n"
    "                    edges,\n"
    "                    arc_to(J, I, M, O)),\n"
    "        put_attr(M,\n"
    "                 edges,\n"
    "                 [arc_from(J, I, D, O)]),\n"
    "        '$clpfd_variables_with_num_occurrences'(F, P),\n"
    "        maplist('$clpfd_val_to_v'(M), P)\n"
    "    ;   E=N\n"
    "    ),\n"
    "    '$clpfd_gcc_arcs'(C, D, N).\n"
    "'$clpfd_variables_with_num_occurrences'(A, B) :-\n"
    "    include(var, A, C),\n"
    "    msort(C, D),\n"
    "    (   D==[]\n"
    "    ->  B=[]\n"
    "    ;   D=[E|F],\n"
    "        '$clpfd_variables_with_num_occurrences'(F, E, 1, B)\n"
    "    ).\n"
    "'$clpfd_variables_with_num_occurrences'([], A, B, [A-B]).\n"
    "'$clpfd_variables_with_num_occurrences'([A|B], C, D, E) :-\n"
    "    (   A==C\n"
    "    ->  F is D+1,\n"
    "        '$clpfd_variables_with_num_occurrences'(B,\n"
    "                                       C,\n"
    "                                       F,\n"
    "                                       E)\n"
    "    ;   E=[C-D|G],\n"
    "        '$clpfd_variables_with_num_occurrences'(B, A, 1, G)\n"
    "    ).\n"
