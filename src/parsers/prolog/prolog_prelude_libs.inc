    "'$gnu_b_spies'(S) :- ( nb_current('$gnu_b_spy', S) -> true ; S = [] ).\n"
    "spy(Spec) :- '$gnu_b_preds'(Spec, spy/1, L), '$gnu_b_spy_set'(L), L \\== [], current_prolog_flag(debug, off), debug, fail.\n"
