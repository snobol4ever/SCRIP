    "'$gnu_b_rdres'(ok(T), X, _) :- X = T.\n"
    "'$gnu_b_rdres'(err(A), _, PI) :- throw(error(syntax_error(A), PI)).\n"
    "get_key(C) :- current_input(S), '$gnu_b_key'(current_input_stream, S, C, get_key/1).\n"
    "get_key(S, C) :- '$gnu_b_key'(S, S, C, get_key/2).\n"
