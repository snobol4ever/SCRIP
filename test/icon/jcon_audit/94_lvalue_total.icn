record pt(a, b)

procedure main()
   local x, L, t, s;
   x := pt(1, 10);
   x.a := 5;
   x.b +:= 7;
   /x.a := 99;
   write(x.a, " ", x.b);
   \x.a := 42;
   write(x.a);
   x.a :=: x.b;
   write(x.a, " ", x.b);
   L := [pt(3, 4), pt(5, 6)];
   L[2].b := 60;
   every (!L).a +:= 100;
   write(L[1].a, " ", L[1].b, " ", L[2].a, " ", L[2].b);
   t := table();
   /t["k"] := 7;
   /t["k"] := 8;
   write(t["k"]);
   s := "abcd";
   s[2] := "X";
   s[3:5] ||:= "!";
   write(s)
end
