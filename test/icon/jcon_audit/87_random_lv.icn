record trip(a, b, c)

procedure main()
  local L, t, s, r;
  write(?100);
  write(?100);
  L := [10,20,30,40,50];
  ?L := 99;
  every write(!L);
  s := "abcde";
  ?s := "X";
  write(s);
  t := table(0);
  t["k"] := 5;
  ?t := 77;
  write(t["k"]);
  r := trip(1,2,3);
  ?r := 42;
  write(r.a, " ", r.b, " ", r.c);
  ?L +:= 1;
  every write(!L);
  write(?"hi")
end
