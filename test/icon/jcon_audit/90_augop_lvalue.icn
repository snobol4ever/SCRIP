record rr(f1, f2)
procedure main()
   local a, L, s, t;
   a := rr(1, 2);
   a.f1 +:= 10;
   a.f2 *:= 3;
   write(a.f1, " ", a.f2);
   L := [5, 6];
   L[1] +:= 100;
   L[2] -:= 1;
   write(L[1], " ", L[2]);
   s := "abcde";
   s[2:4] ||:= "X";
   write(s);
   t := table(0);
   t["k"] +:= 7;
   write(t["k"]);
end
