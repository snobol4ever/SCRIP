procedure main()
  L := [1,2,3];
  every L[2] <- 9 do write(L[2]);
  write(L[2]);
  t := table(0);
  t["k"] := 1;
  every t["k"] <- 5 do write(t["k"]);
  write(t["k"]);
  if L[1] <- 7 then write(L[1]);
  write(L[1]);
  M := [[1,2],[3,4]];
  every M[1,2] <- 8 do write(M[1,2]);
  write(M[1,2]);
  u := table(0);
  every u["z"] <- 3 do write(u["z"]);
  write(u["z"]);
  write(*u)
end
