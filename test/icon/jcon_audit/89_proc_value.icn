procedure double(n)
  return n * 2
end

procedure main()
  local p, q;
  write(type(main));
  write(type(write));
  write(image(main));
  write(image(push));
  write(args(main));
  write(args(double));
  p := image;
  write(p("hi"));
  q := double;
  write(q(21));
  write("double"(5));
  write(2(10, 20, 30));
  write((-1)(10, 20, 30));
  p := reverse;
  write(p("abc"))
end
