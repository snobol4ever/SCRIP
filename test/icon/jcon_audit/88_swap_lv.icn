procedure main()
  local x, y, s, t, L, v;
  x := 1;
  y := 2;
  x :=: y;
  write(x, " ", y);
  s := "abcd";
  s[2] :=: s[3];
  write(s);
  s := "abcdef";
  s[2:4] :=: s[5:6];
  write(s);
  s := "hello";
  t := "world";
  s[1] :=: t[5];
  write(s, " ", t);
  L := [10, 20, 30];
  L[1] :=: L[3];
  every write(!L);
  s := "wxyz";
  L[2] :=: s[4];
  write(L[2], " ", s);
  s := "pq";
  v := (s[1] :=: s[2]);
  write(v, " ", s)
end
