procedure main()
   local t, x, L;
   t := table();
   /t["a"] := [1];
   /t["a"] := [99];
   write(*t["a"], " ", t["a"][1]);
   x := &null;
   /x := 5;
   write(x);
   /x := 6 | write("second-assign-failed");
   \x := 7;
   write(x);
   L := [&null, 2];
   /L[1] := 10;
   /L[2] := 20 | write("L2-nonnull");
   write(L[1], " ", L[2]);
end
