        LGT('abc', 'xyz')          :f(e001)
        OUTPUT = 'FAIL 914/001: lgt(abc,xyz) should fail'   :(END)
e001

*       equal strings — LGT fails (strictly greater, not >=)
        LGT('abc', 'abc')          :f(e002)
        OUTPUT = 'FAIL 914/002: lgt(abc,abc) should fail'   :(END)
e002

*       'xyz' > 'abc' — should succeed
        LGT('xyz', 'abc')          :s(e003)
        OUTPUT = 'FAIL 914/003: lgt(xyz,abc) should succeed' :(END)
e003

*       null < any non-empty string
        LGT('', 'abc')             :f(e004)
        OUTPUT = 'FAIL 914/004: lgt(null,abc) should fail'  :(END)
e004

*       any non-empty string > null
        LGT('abc', '')             :s(e005)
