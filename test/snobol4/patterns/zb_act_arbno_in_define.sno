*  Minimal probe: ARBNO inside a DEFINE'd procedure, to force g_frame_active=1
*  at the point the ARBNO chain compiles (as opposed to a plain top-level
*  statement, which compiles as part of main's own non-frame chain).
        DEFINE('MATCHIT(S)') :(MATCHIT_END)
MATCHIT S POS(0) ARBNO('a') . V RPOS(0)                            :S(MI_YES)
        MATCHIT = 'fail'                                            :(RETURN)
MI_YES  MATCHIT = V                                                 :(RETURN)
MATCHIT_END
        OUTPUT = MATCHIT('aaa')
END
